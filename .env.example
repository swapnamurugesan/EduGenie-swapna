# ==========================================
# EduGenie Environment Configuration Example
# Copy this file to .env and insert your real keys.
# ==========================================

# Google Gemini Cloud API Key (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Identifier (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Explanation Provider Mode: 'gemini' (cloud AI) or 'local' (offline Hugging Face transformer)
EXPLANATION_PROVIDER=gemini

# Local Hugging Face Model Identifier (when EXPLANATION_PROVIDER=local)
LOCAL_MODEL_ID=MBZUAI/LaMini-Flan-T5-783M

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30.0

# In-memory demo rate limiter (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
